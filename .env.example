# ============================================
# HackHub Environment Configuration
# ============================================
# ISTRUZIONI:
# 1. Copia questo file come .env: cp .env.example .env
# 2. Compila tutti i valori
# 3. NON committare MAI il file .env nel repository!
# ============================================

# ============ DATABASE ============
DB_NAME=hackhub_db
DB_USERNAME=admin
DB_PASSWORD=   # Genera una password sicura (min 16 caratteri, mix maiuscole/minuscole/numeri/simboli)

# ============ JWT AUTHENTICATION ============
# Genera con: openssl rand -base64 64
# Oppure su Windows PowerShell: [Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
HACKHUB_APP_JWTSECRETBASE64=

# ============ SPRING PROFILE ============
# dev = development mode con log dettagliati
# prod = production mode ottimizzato
SPRING_PROFILE=prod

# ============ OPTIONAL: CLOUD DEPLOYMENT ============
# Decommentare e configurare se si usa un cloud provider

# Azure
# AZURE_WEBAPP_NAME=
# AZURE_PUBLISH_PROFILE=

# AWS
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-west-1
